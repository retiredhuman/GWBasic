8310 ' --- promotion-threat urgency (red POV); called from 4515 ---
8320 ' NT = 1 when the piece at (R,C) could become a king on its next
8330 ' move: a step from row 6 (blue) / row 1 (red) into a free last-row
8340 ' square, or a jump from row 5 (blue) / row 2 (red) over an enemy
8350 ' piece with a free last-row landing.  SV -30 per blue threat,
8360 ' +30 per red threat.  (Scratch: NT; loops reuse R, C, P)
8370 ' NOTE: a false "IF cond THEN n" falls through to the next line,
8380 ' so each guard jumps to a continuation PAST its protected array
8390 ' reference; AND is evaluated eagerly here, so guards carry no
8400 ' array refs.  (Same discipline as line 5520/5530)
8410 FOR R = 0 TO 7
8420 FOR C = DS0(R) TO 7 STEP 2
8430 P = VB(R,C)
8440 IF P = 0 THEN 8700
8450 NT = 0
8460 IF P = 1 THEN 8490
8470 IF P = 4 THEN 8600
8480 GOTO 8700
8490 ' --- blue man: row 6 step threat, row 5 promoting-jump threat ---
8500 IF R <> 6 AND R <> 5 THEN 8700
8510 IF R <> 6 OR C = 0 THEN 8530
8520 IF VB(7,C-1) = 0 THEN NT = 1
8530 IF R <> 6 OR C = 7 THEN 8550
8540 IF VB(7,C+1) = 0 THEN NT = 1
8550 IF R <> 5 OR C < 2 THEN 8570
8560 IF VB(6,C-1) > 3 AND VB(7,C-2) = 0 THEN NT = 1
8570 IF R <> 5 OR C > 5 THEN 8590
8580 IF VB(6,C+1) > 3 AND VB(7,C+2) = 0 THEN NT = 1
8590 GOTO 8700
8600 ' --- red man: row 1 step threat, row 2 promoting-jump threat ---
8610 IF R <> 1 AND R <> 2 THEN 8700
8620 IF R <> 1 OR C = 0 THEN 8640
8630 IF VB(0,C-1) = 0 THEN NT = 1
8640 IF R <> 1 OR C = 7 THEN 8660
8650 IF VB(0,C+1) = 0 THEN NT = 1
8660 IF R <> 2 OR C < 2 THEN 8680
8670 IF VB(1,C-1) > 0 AND VB(1,C-1) < 3 AND VB(0,C-2) = 0 THEN NT = 1
8680 IF R <> 2 OR C > 5 THEN 8700
8690 IF VB(1,C+1) > 0 AND VB(1,C+1) < 3 AND VB(0,C+2) = 0 THEN NT = 1
8700 IF P = 1 AND NT = 1 THEN SV = SV - 30
8710 IF P = 4 AND NT = 1 THEN SV = SV + 30
8720 NEXT C
8730 NEXT R
8740 RETURN
8750 ' --- hard promotion rule (all skill levels): scan red's legal moves;
8760 ' if any promotes a red man to a king (man at origin, final landing on
8770 ' row 0) set BK to the best such move -- the one taking the most pieces,
8780 ' else the first found -- and RETURN; the caller plays it and skips the
8790 ' random pick and the search.  Non-promoting moves (even big captures)
8800 ' never qualify.  Scratch: TI, PC, PCB
8810 BK = 0
8820 PCB = 0
8830 FOR TI = 1 TO NM0
8840 IF B(MFR(1,TI,1),MFC(1,TI,1)) <> 4 THEN 8910
8850 IF MTR(1,TI,NJ(1,TI)) <> 0 THEN 8910
8860 PC = 0
8870 IF MCP(1,TI,1) = 1 THEN PC = NJ(1,TI)
8880 IF BK <> 0 AND PC <= PCB THEN 8910
8890 BK = TI : PCB = PC
8900 GOTO 8910
8910 NEXT TI
8920 RETURN
8930 ' --- signed jump-direction count for piece P at (R,C) into CT (scratch:
8940 '     K, D, EN, NR, NC, LR, LC, SG; P, R, C from the caller; all square
8950 '     refs range-checked before use, so the eager AND below is safe)
8960 K = 0
8970 D = 1
8980 IF P = 4 THEN D = -1
8990 EN = 1
9000 IF P < 3 THEN EN = 4
9010 NR = R+D : NC = C-1 : LR = R+2*D : LC = C-2
9020 IF NR < 0 OR NR > 7 OR NC < 0 OR NC > 7 OR LR < 0 OR LR > 7 OR LC < 0 OR LC > 7 THEN 9040
9030 IF (VB(NR,NC) = EN OR VB(NR,NC) = EN+1) AND VB(LR,LC) = 0 THEN K = K + 1
9040 NR = R+D : NC = C+1 : LR = R+2*D : LC = C+2
9050 IF NR < 0 OR NR > 7 OR NC < 0 OR NC > 7 OR LR < 0 OR LR > 7 OR LC < 0 OR LC > 7 THEN 9070
9060 IF (VB(NR,NC) = EN OR VB(NR,NC) = EN+1) AND VB(LR,LC) = 0 THEN K = K + 1
9070 IF P = 1 OR P = 4 THEN 9160
9080 ' man skipped to the signed total above; king: the other diagonal
9090 D = -D
9100 NR = R+D : NC = C-1 : LR = R+2*D : LC = C-2
9110 IF NR < 0 OR NR > 7 OR NC < 0 OR NC > 7 OR LR < 0 OR LR > 7 OR LC < 0 OR LC > 7 THEN 9130
9120 IF (VB(NR,NC) = EN OR VB(NR,NC) = EN+1) AND VB(LR,LC) = 0 THEN K = K + 1
9130 NR = R+D : NC = C+1 : LR = R+2*D : LC = C+2
9140 IF NR < 0 OR NR > 7 OR NC < 0 OR NC > 7 OR LR < 0 OR LR > 7 OR LC < 0 OR LC > 7 THEN 9160
9150 IF (VB(NR,NC) = EN OR VB(NR,NC) = EN+1) AND VB(LR,LC) = 0 THEN K = K + 1
9160 SG = 1
9170 IF P < 3 THEN SG = -1
9180 CT = CT + SG*K
9190 RETURN
