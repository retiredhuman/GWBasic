5930 GOTO 6100
5940 ' no forced capture: collect plain forward moves
5950 FOR R = 0 TO 7
5960 FOR C = DS0(R) TO 7 STEP 2
5970 IF VB(R,C) <> T AND VB(R,C) <> T+1 THEN 6080
5980 IF VB(R,C) = T+1 THEN 6030
5990 DK = -1
6000 IF T = 1 THEN DK = 1
6010 GOSUB 7030
6020 GOTO 6080
6030 DK = -1
6040 GOSUB 7030
6050 DK = 1
6060 GOSUB 7030
6070 GOTO 6080
6080 NEXT C
6090 NEXT R
6100 RETURN
6110 ' --- if side T piece at (R,C) can capture in direction DK, set FQ=1 ---
6120 FOR DD = -1 TO 1 STEP 2
6130 NR = R+DK : NC = C+DD : LR = R+2*DK : LC = C+2*DD
6140 IF NR < 0 OR NR > 7 OR LR < 0 OR LR > 7 OR NC < 0 OR NC > 7 OR LC < 0 OR LC > 7 THEN 6170
6150 IF VB(NR,NC) = 5-T AND VB(LR,LC) = 0 THEN FQ = 1
6160 IF VB(NR,NC) = 6-T AND VB(LR,LC) = 0 THEN FQ = 1
6170 NEXT DD
6180 RETURN
6190 ' --- expand all maximal jump chains from (PR,PC), piece value PV, on W ---
6200 ' chain so far: CHJ jumps in JFR..JDX; a chain with no further jump (CHJ>0)
6210 ' is recorded into the LDE move list. A jump that PROMOTES the piece ends
6220 ' the move (standard 8x8 rule): the chain is recorded at once (PRMF) and the
6230 ' direction loop continues with the OTHER jumps from this origin.  W, CHJ
6240 ' and all frame state are restored on exit.  No FOR loops here: this routine
6250 ' recurses via GOSUB 3020; all stepping is manual and per-jump frame state
6260 ' lives in the J*(CHJ) arrays so it survives the recursive call.
6270 ANYEXT = 0 : PRMF = 0
6280 NDS = 1
6290 IF PV = 2 OR PV = 5 THEN NDS = 2
6300 DIDX = 1
6310 IF DIDX > NDS THEN 6790
6320 DK = 1
6330 IF PV = 4 THEN DK = -1
6340 IF NDS = 2 THEN DK = -1
6350 IF NDS = 2 AND DIDX = 2 THEN DK = 1
6360 DD = -1
6370 IF DD > 1 THEN 6770
6380 NR = PR+DK : NC = PC+DD : LR = PR+2*DK : LC = PC+2*DD
6390 IF NR < 0 OR NR > 7 OR LR < 0 OR LR > 7 OR NC < 0 OR NC > 7 OR LC < 0 OR LC > 7 THEN 6750
6400 IF W(NR,NC) <> 5-T AND W(NR,NC) <> 6-T THEN 6750
6410 IF W(LR,LC) <> 0 THEN 6750
6420 IF CHJ >= 8 THEN 6750
6430 ANYEXT = 1
6440 CHJ = CHJ + 1
6450 JFR(CHJ) = PR : JFC(CHJ) = PC : JTR(CHJ) = LR : JTC(CHJ) = LC
6460 JCR(CHJ) = NR : JCC(CHJ) = NC : JCV(CHJ) = W(NR,NC) : JPV(CHJ) = PV
6470 JDK(CHJ) = DK : JDD(CHJ) = DD : JDX(CHJ) = DIDX
6480 W(PR,PC) = 0
6490 W(NR,NC) = 0
6500 NPV = PV
6510 W(LR,LC) = PV
6520 IF PV = 1 AND LR = 7 THEN W(LR,LC) = 2
6530 IF PV = 4 AND LR = 0 THEN W(LR,LC) = 5
6540 IF PV = 1 AND LR = 7 THEN NPV = 2
6550 IF PV = 4 AND LR = 0 THEN NPV = 5
6560 PR = LR : PC = LC
6570 IF PV <> NPV THEN 6910
6580 PV = NPV : GOSUB 6190
6590 ' restore frame state (the recursive call clobbered every scalar here)
6600 PR = JFR(CHJ) : PC = JFC(CHJ)
6610 NDS = 1
6620 IF JPV(CHJ) = 2 OR JPV(CHJ) = 5 THEN NDS = 2
6630 DIDX = JDX(CHJ)
6640 DK = 1
6650 IF JPV(CHJ) = 4 THEN DK = -1
6660 IF NDS = 2 THEN DK = -1
6670 IF NDS = 2 AND DIDX = 2 THEN DK = 1
6680 ANYEXT = 1
6690 W(JTR(CHJ),JTC(CHJ)) = 0
6700 W(JCR(CHJ),JCC(CHJ)) = JCV(CHJ)
6710 W(JFR(CHJ),JFC(CHJ)) = JPV(CHJ)
6720 DD = JDD(CHJ) + 2
6730 CHJ = CHJ - 1
6740 GOTO 6370
6750 DD = DD + 2
6760 GOTO 6370
6770 DIDX = DIDX + 1
6780 GOTO 6310
6790 IF ANYEXT = 1 THEN 6950
6800 IF CHJ = 0 THEN 6950
6810 PRMF = 0
6820 IF NM >= 64 THEN 6950
6830 NM = NM + 1
6840 NJ(LDE,NM) = CHJ
6850 J = 1
6860 IF J > CHJ THEN 6940
6870 MFR(LDE,NM,J) = JFR(J) : MFC(LDE,NM,J) = JFC(J)
6880 MTR(LDE,NM,J) = JTR(J) : MTC(LDE,NM,J) = JTC(J) : MCP(LDE,NM,J) = 1
6890 J = J + 1
6900 GOTO 6860
6910 IF NM >= 64 THEN 6590
6920 PRMF = 1
6930 GOTO 6820
6940 IF PRMF = 1 THEN 6590
6950 RETURN
6960 ' --- add candidate plain move (R,C) -> (NR,NC) to the LDE-level list ---
6970 IF NM >= 64 THEN 7020
6980 NM = NM + 1
6990 NJ(LDE,NM) = 1
7000 MFR(LDE,NM,1) = R : MFC(LDE,NM,1) = C
7010 MTR(LDE,NM,1) = NR : MTC(LDE,NM,1) = NC : MCP(LDE,NM,1) = 0
7020 RETURN
7030 ' --- add plain moves in direction DK for side T piece at (R,C) ---
7040 FOR DD = -1 TO 1 STEP 2
7050 NR = R+DK : NC = C+DD
7060 IF NR < 0 OR NR > 7 OR NC < 0 OR NC > 7 THEN 7090
7070 IF VB(NR,NC) <> 0 THEN 7090
7080 GOSUB 6960
7090 NEXT DD
7100 RETURN
7110 ' --- alpha-beta search: score (SV, red POV) for side T to move at level LDE
7120 ' DE = horizon (full plies): levels LDE<=DE are full, LDE>DE is
7130 ' quiescent (forced capture chains only, up to 8 levels, then stand-
7140 ' pat eval).  GOSUB clobbers every scalar, so per-level state lives in
7150 ' arrays: MSVD(LDE,1..3)=NM/I/BS, window in ALPH(LDE)/BETH(LDE), board
7160 ' snapshot in VSB(LDE).  DE survives every GOSUB below (7010 reads LDE,
7170 ' not DE), so the horizon may stay a scalar.  Time control: T0/TLIM set
7180 ' by the driver (3467); TLIM=0 (old headless benches) disables 6645-6648.
7190 ' At the deadline ABRT latches and 6648 bails to 7005 with SV = garbage:
7200 ' the driver discards the aborted step and plays the last completed one.
7210 ' 6646-6648 stay on separate lines: after a single-line IF, further stmts on the line nest in its THEN block.
7220 IF TLIM <= 0 THEN 7260
7230 DIF = TIMER - T0 : IF DIF < 0 THEN DIF = DIF + 86400
7240 IF DIF > TLIM THEN ABRT = 1 : locate 50,50 : textsize 10 : rem print "depth ";de
7250 IF ABRT = 1 THEN 7860
7260 IF LDE > DE THEN 7370
7270 GOSUB 5570
7280 IF NM = 0 THEN 7300
7290 GOTO 7520
7300 ' --- no legal move for T: T is stuck and loses; PLY = LDE = moves
7310 '     already played (matches the python reference), so a sooner loss
7320 '     scores higher for the winner ---
7330 PLY = LDE
7340 IF PLY < 1 THEN PLY = 1
7350 SV = PLY - 100000 : IF T = 1 THEN SV = 100000 - PLY
7360 RETURN
7370 ' --- quiescence level: only forced capture chains extend the line;
7380 '     with no move, no capture (or 8 levels past DE) the line stands
7390 '     pat.  No-move here is a stand-pat, NOT the mate score: full
7400 '     levels (LDE<=DE) use the 6730 loss score (python ab_search),
7410 '     but python qsearch returns the static eval when a side has no
7420 '     move, so a wipe-out inside the quiescence window scores only
7430 '     its material value ---
7440 GOSUB 5570
7450 IF NM = 0 THEN 7490
7460 IF MCP(LDE,1,1) = 0 THEN 7490
7470 IF LDE > DE + 8 THEN 7490
7480 GOTO 7520
7490 ' --- stand-pat: static eval ends the line ---
7500 GOSUB 5290
7510 RETURN
7520 ' --- move loop (shared by full and quiescence levels) ---
7530 BS = 99999 : IF T = 4 THEN BS = -99999
7540 I = 1
7550 IF I > NM THEN 7820
7560 IF ABRT = 1 THEN 7850
7570 MSVD(LDE,1) = NM : MSVD(LDE,2) = I : MSVD(LDE,3) = BS
7580 ALPH(LDE+1) = ALPH(LDE) : BETH(LDE+1) = BETH(LDE)
7590 FOR R = 0 TO 7
7600 FOR C = DS0(R) TO 7 STEP 2
7610 VSB(LDE,R,C) = VB(R,C)
7620 NEXT C : NEXT R
7630 GOSUB 7870
7640 T = 5 - T : LDE = LDE + 1
7650 GOSUB 7110
7660 T = 5 - T : LDE = LDE - 1
7670 FOR R = 0 TO 7
7680 FOR C = DS0(R) TO 7 STEP 2
7690 VB(R,C) = VSB(LDE,R,C)
7700 NEXT C : NEXT R
7710 NM = MSVD(LDE,1) : I = MSVD(LDE,2) : BS = MSVD(LDE,3)
7720 IF T = 4 THEN 7790
7730 IF SV < BS THEN BS = SV
7740 IF BS < BETH(LDE) THEN BETH(LDE) = BS
7750 ' min node: only BETH narrows.  (Updating ALPH here would make
7760 ' alpha equal the running min and cut the node off after its first
7770 ' child, so skip the alpha update and go straight to the test.)
7780 GOTO 7810
7790 IF SV > BS THEN BS = SV
7800 IF BS > ALPH(LDE) THEN ALPH(LDE) = BS
7810 IF ALPH(LDE) < BETH(LDE) THEN 7830
7820 GOTO 7850
7830 I = I + 1
7840 IF I <= NM THEN 7570
7850 SV = BS
7860 RETURN
7870 ' --- apply move #(LDE,I) (a complete multi-jump sequence) to VB ---
7880 JQ = 1
7890 P = VB(MFR(LDE,I,1),MFC(LDE,I,1))
7900 IF JQ > NJ(LDE,I) THEN 8010
7910 OWR = MFR(LDE,I,JQ) : OWC = MFC(LDE,I,JQ)
7920 IF MCP(LDE,I,JQ) <> 1 THEN 7940
7930 VR = INT((OWR+MTR(LDE,I,JQ))/2) : VC = INT((OWC+MTC(LDE,I,JQ))/2) : VB(VR,VC) = 0
7940 VB(OWR,OWC) = 0
7950 VB(MTR(LDE,I,JQ),MTC(LDE,I,JQ)) = P
7960 IF P = 1 AND MTR(LDE,I,JQ) = 7 THEN VB(MTR(LDE,I,JQ),MTC(LDE,I,JQ)) = 2
7970 IF P = 4 AND MTR(LDE,I,JQ) = 0 THEN VB(MTR(LDE,I,JQ),MTC(LDE,I,JQ)) = 5
7980 P = VB(MTR(LDE,I,JQ),MTC(LDE,I,JQ))
7990 JQ = JQ + 1
8000 GOTO 7900
8010 RETURN
8020 ' --- erase the 'Thinking' banner by redrawing exactly what it covered.
